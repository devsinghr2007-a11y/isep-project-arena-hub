# MongoDB Atlas or local MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=arenaHub

# Required in production. Use a long random value.
JWT_SECRET=replace-with-a-long-random-secret

# Optional comma-separated accounts that should have administrator access.
ADMIN_EMAILS=admin@example.com

# Gmail OTP delivery. In your Gmail account enable 2-Step Verification, then
# create an App Password at https://myaccount.google.com/apppasswords.
# Do not use your normal Gmail password here.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
# Optional display address; normally leave this equal to GMAIL_USER.
GMAIL_FROM=your-gmail-address@gmail.com

# Razorpay platform credentials. Keep the secret server-side only; never place it
# in VITE_ variables or paste it into the browser. Use test-mode keys locally.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Each checkout creates a 15-minute server-side payment session. The selected
# court slot and rental equipment are held until payment verification or expiry.

# Set to true only after Razorpay has enabled Route for this account. Arena owners
# and shopkeepers enter their own linked-account IDs in the protected app screen.
RAZORPAY_ROUTE_ENABLED=false
