MONGO_URI=mongodb://127.0.0.1:27017/arenaHub
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
PORT=5000

# Cashfree Payments. Use `sandbox` while testing, then change to `production`
# only after your Cashfree merchant account and domain are approved.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional. The hosted checkout modal works without these in local testing.
# Production webhook URLs must be publicly accessible over HTTPS.
CASHFREE_RETURN_URL=
CASHFREE_NOTIFY_URL=

# Email OTP — Gmail account with a Google App Password
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
GMAIL_FROM=ArenaHub <your-gmail-address@gmail.com>

# OTP expiry; values from 5 to 30 are accepted
OTP_TTL_MINUTES=10

# Google Maps automatic arena verification (enable Places API (New) in Google Cloud)
GOOGLE_MAPS_API_KEY=your-google-maps-server-api-key
# Optional; defaults to IN for arena searches
GOOGLE_MAPS_REGION=IN
